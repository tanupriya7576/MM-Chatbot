# Git Ignore for Multimodal AI Assistant

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/

# Databases (Local SQLite & Data)
*.sqlite3
*.sqlite
*.db
assistant.db
backend/assistant.db
pgdata/

# Environment & Secrets (NEVER COMMIT SENSITIVE API KEYS)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# Node / Frontend
node_modules/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
.parcel-cache

# Uploads & Temp Generated Files
uploads/*
!uploads/.gitkeep
generated/*
!generated/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
backend/generated/*
!backend/generated/.gitkeep

# IDEs & System
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
