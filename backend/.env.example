# ====================================================================
# Multimodal AI Personal Assistant - Environment Configuration
# ====================================================================

# 1. GOOGLE GEMINI API (Primary LLM, Vision OCR & Embeddings)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. OPENAI API (Secondary Backup LLM & Vision)
OPENAI_API_KEY=your_openai_api_key_here

# 3. HUGGING FACE API (Backup LLM & AI Models)
HUGGINGFACE_API_KEY=your_huggingface_token_here

# 4. TAVILY SEARCH API (AI Web Search Engine - 1,000 Free Searches)
TAVILY_API_KEY=your_tavily_api_key_here

LLM_PROVIDER=auto
LLM_MODEL=gemini-3.5-flash-lite
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=models/text-embedding-004

DATABASE_URL=sqlite:///./assistant.db
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/multimodal_ai

UPLOAD_DIR=./uploads
GENERATED_DIR=./generated
MAX_FILE_SIZE_MB=20

HOST=0.0.0.0
PORT=5173
DEBUG=True
CORS_ORIGINS=*
